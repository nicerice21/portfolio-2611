# Public: inlined at build time (safe to expose)
PUBLIC_SITE_URL=https://example.com
PUBLIC_ASSETS_BASE_URL=https://assets.example.com

# Optional analytics (leave empty to disable)
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_CF_BEACON_TOKEN=

# Server-side feed sources
QIITA_FEED_URL=https://qiita.com/<user_id>/feed
HATENA_FEED_URL=https://<blog_domain>/rss
