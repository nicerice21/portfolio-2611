{
	"name": "portfolio-2611",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_flags": ["nodejs_als"],
	"compatibility_date": "2025-04-01",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"vars": {
		"PUBLIC_SITE_URL": "https://ricezero.fun",
		"PUBLIC_ASSETS_BASE_URL": "https://assets.ricezero.fun",
		"PUBLIC_GA_MEASUREMENT_ID": "",
		"PUBLIC_CF_BEACON_TOKEN": "",
		"QIITA_FEED_URL": "https://qiita.com/ricezero/feed",
		"HATENA_FEED_URL": "https://blog.ricezero.fun/rss"
	}
}
